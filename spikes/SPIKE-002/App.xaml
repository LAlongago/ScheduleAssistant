<Application x:Class="ScheduleAssistant.Spike002.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#F4F6F8" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InkBrush" Color="#20252B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65717D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2D6CDF" />
        <SolidColorBrush x:Key="WarningBrush" Color="#A85D00" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#1F7A4D" />

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D2D8DE" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
    </Application.Resources>
</Application>
