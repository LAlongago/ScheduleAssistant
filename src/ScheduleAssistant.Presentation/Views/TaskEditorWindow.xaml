<Window x:Class="ScheduleAssistant.Presentation.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="920"
        Height="820"
        MinWidth="760"
        MinHeight="640"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource FontFamily.App}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="{DynamicResource Spacing.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{Binding WindowTitle}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Caption}"
                           Text="普通任务 · 保存由 Application 用例负责" />
            </StackPanel>
            <Border Grid.Column="1"
                    Margin="16,0,0,0"
                    Style="{StaticResource PillBorder}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="状态：" />
                    <TextBlock FontWeight="{DynamicResource FontWeight.SemiBold}"
                               Text="{Binding StatusText}" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Margin="0,0,0,12"
                        Background="{DynamicResource Brush.SurfaceSubtle}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="{DynamicResource BorderThickness.Subtle}"
                        CornerRadius="{DynamicResource Radius.Card}"
                        Padding="{DynamicResource Spacing.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="表单提示" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" />
                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ValidationMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource Brush.Danger}"
                                               Text="•  {Binding}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   Text="{Binding WarningMessage}"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ReloadCommand}"
                                Content="重新加载任务"
                                IsEnabled="{Binding CanReload}"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="并发冲突后重新读取数据库中的任务" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource CardBorder}"
                                Padding="{DynamicResource Spacing.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="基本信息" />
                                <TextBlock Margin="0,14,0,4" Style="{StaticResource Text.Caption}" Text="标题 *" />
                                <TextBox AutomationProperties.Name="任务标题"
                                         MaxLength="200"
                                         Style="{StaticResource TextBox.Base}"
                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Margin="0,12,0,4" Style="{StaticResource Text.Caption}" Text="类型 *" />
                                <ComboBox AutomationProperties.Name="任务类型"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding CategoryOptions}"
                                          SelectedValue="{Binding SelectedCategoryId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                          SelectedValuePath="Id" />
                                <TextBlock Margin="0,12,0,4" Style="{StaticResource Text.Caption}" Text="优先级" />
                                <ComboBox AutomationProperties.Name="任务优先级"
                                          DisplayMemberPath="Label"
                                          ItemsSource="{Binding PriorityOptions}"
                                          SelectedValue="{Binding SelectedPriority, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                          SelectedValuePath="Value" />
                                <TextBlock Margin="0,12,0,4" Style="{StaticResource Text.Caption}" Text="工作流状态（只读）" />
                                <Border Style="{StaticResource PillBorder}">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Style="{StaticResource CardBorder}"
                                Padding="{DynamicResource Spacing.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="截止与提醒" />
                                <CheckBox Margin="0,14,0,0"
                                          AutomationProperties.Name="启用 Deadline"
                                          Content="设置 Deadline"
                                          IsChecked="{Binding HasDeadline, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource CheckBox.Base}" />
                                <Grid Margin="0,10,0,0" IsEnabled="{Binding HasDeadline}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Deadline 日期" />
                                    <DatePicker Grid.Row="1"
                                                AutomationProperties.Name="Deadline 日期"
                                                SelectedDate="{Binding DeadlineDateValue, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Grid.Row="2" Margin="0,10,0,4" Style="{StaticResource Text.Caption}" Text="Deadline 时间（例如 23:59）" />
                                    <TextBox Grid.Row="3"
                                             AutomationProperties.Name="Deadline 时间"
                                             Style="{StaticResource TextBox.Base}"
                                             Text="{Binding DeadlineTimeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                </Grid>
                                <TextBlock Margin="0,10,0,4" Style="{StaticResource Text.Caption}" Text="本机 Windows 时区" />
                                <TextBlock FontWeight="{DynamicResource FontWeight.SemiBold}" Text="{Binding TimeZoneDisplayName}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding TimeZoneId}" />
                                <CheckBox Margin="0,14,0,0"
                                          AutomationProperties.Name="启用提醒"
                                          Content="启用截止提醒"
                                          IsChecked="{Binding ReminderEnabled, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding HasDeadline}"
                                          Style="{StaticResource CheckBox.Base}" />
                                <Grid Margin="0,8,0,0" IsEnabled="{Binding HasDeadline}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="提醒偏移" />
                                    <ComboBox Grid.Column="1"
                                              Margin="12,0,0,0"
                                              DisplayMemberPath="Label"
                                              ItemsSource="{Binding ReminderOffsetOptions}"
                                              SelectedValue="{Binding ReminderOffsetMinutes, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardBorder}"
                                Padding="{DynamicResource Spacing.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="执行计划" />
                                <TextBlock Margin="0,14,0,4" Style="{StaticResource Text.Caption}" Text="计划日期" />
                                <DatePicker AutomationProperties.Name="计划日期"
                                            SelectedDate="{Binding PlannedDateValue, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Caption}" Text="开始时间" />
                                        <TextBox AutomationProperties.Name="计划开始时间"
                                                 Style="{StaticResource TextBox.Base}"
                                                 Text="{Binding PlannedStartText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Caption}" Text="结束时间" />
                                        <TextBox AutomationProperties.Name="计划结束时间"
                                                 Style="{StaticResource TextBox.Base}"
                                                 Text="{Binding PlannedEndText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,12,0,4" Style="{StaticResource Text.Caption}" Text="地点" />
                                <TextBox AutomationProperties.Name="任务地点"
                                         MaxLength="300"
                                         Style="{StaticResource TextBox.Base}"
                                         Text="{Binding Location, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Style="{StaticResource CardBorder}"
                                Padding="{DynamicResource Spacing.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="内容" />
                                <TextBlock Margin="0,14,0,4" Style="{StaticResource Text.Caption}" Text="具体事务" />
                                <TextBox AutomationProperties.Name="具体事务"
                                         AcceptsReturn="True"
                                         Height="84"
                                         MaxLength="10000"
                                         Style="{StaticResource TextBox.Base}"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock Margin="0,12,0,4" Style="{StaticResource Text.Caption}" Text="材料准备" />
                                <TextBox AutomationProperties.Name="材料准备"
                                         AcceptsReturn="True"
                                         Height="84"
                                         MaxLength="10000"
                                         Style="{StaticResource TextBox.Base}"
                                         Text="{Binding Materials, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock Margin="0,12,0,4" Style="{StaticResource Text.Caption}" Text="备注" />
                                <TextBox AutomationProperties.Name="备注"
                                         AcceptsReturn="True"
                                         Height="84"
                                         MaxLength="10000"
                                         Style="{StaticResource TextBox.Base}"
                                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource Brush.SurfaceSubtle}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="{DynamicResource BorderThickness.Subtle}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="{DynamicResource Spacing.Card}"
                            IsEnabled="{Binding IsAttachmentsEnabled}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="附件" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}" Text="{Binding AttachmentsPlaceholder}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2"
                            Background="{DynamicResource Brush.SurfaceSubtle}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="{DynamicResource BorderThickness.Subtle}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="{DynamicResource Spacing.Card}"
                            IsEnabled="{Binding IsRecurrenceEnabled}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="周期" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}" Text="{Binding RecurrencePlaceholder}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0">
            <Grid>
                <ProgressBar Width="140"
                             Height="4"
                             HorizontalAlignment="Left"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            AutomationProperties.Name="取消编辑"
                            Command="{Binding CancelCommand}"
                            Content="取消"
                            Style="{StaticResource Button.Secondary}" />
                    <Button AutomationProperties.Name="保存任务"
                            Command="{Binding SaveCommand}"
                            Content="保存"
                            IsDefault="True"
                            Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
