<UserControl x:Class="ScheduleAssistant.Presentation.Views.WeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScheduleAssistant.Presentation.Controls"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <ScrollViewer Padding="{DynamicResource Spacing.Page}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="{DynamicResource Spacing.Section}"
                       Style="{StaticResource Text.Body}"
                       Text="{Binding Description}" />
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Width="38"
                        Height="38"
                        AutomationProperties.Name="上一周"
                        Command="{Binding PreviousWeekCommand}"
                        Content="‹"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="上一周" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="本周"
                        Command="{Binding CurrentWeekCommand}"
                        Content="本周"
                        Style="{StaticResource Button.Secondary}" />
                <TextBlock Grid.Column="2"
                           Margin="{DynamicResource Spacing.GapMedium}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.SectionTitle}"
                           Text="{Binding WeekRangeText}" />
                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="下一周"
                        Command="{Binding NextWeekCommand}"
                        Content="›"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="下一周" />
            </Grid>

            <controls:PageStatePresenter State="{Binding ContentState}"
                                         StatusTitle="{Binding StatusTitle}"
                                         StatusMessage="{Binding StatusMessage}">
                <controls:PageStatePresenter.NormalContent>
                    <ItemsControl ItemsSource="{Binding WeekDays}"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinWidth="128"
                                        Margin="0,0,8,0"
                                        Padding="{DynamicResource Spacing.GapSmall}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource CardBorder}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Text.Caption}"
                                                   Text="{Binding WeekdayText}" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,2,0,0"
                                                   Style="{StaticResource Text.SectionTitle}"
                                                   Text="{Binding DateText}" />
                                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:WeekTaskCard Margin="0,0,0,8" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"
                                                       Text="暂无事项">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Caption}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTasks}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:PageStatePresenter.NormalContent>
            </controls:PageStatePresenter>
        </StackPanel>
    </ScrollViewer>
</UserControl>
