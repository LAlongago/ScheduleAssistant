<Window x:Class="ScheduleAssistant.Presentation.Views.ConfirmRecurrenceActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        MinWidth="460"
        SizeToContent="Height"
        MaxHeight="520"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource FontFamily.App}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{DynamicResource Spacing.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40"
                    Height="40"
                    Background="{DynamicResource Brush.AccentSoft}"
                    CornerRadius="{DynamicResource Radius.Control}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="{DynamicResource FontWeight.Bold}"
                           Foreground="{DynamicResource Brush.Warning}"
                           Text="!" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock x:Name="MessageText"
                           Margin="0,8,0,0"
                           Style="{StaticResource Text.Body}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1"
                   Margin="52,12,0,16"
                   Style="{StaticResource Text.Caption}"
                   Text="请检查操作范围和日期；确认后将立即提交。" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    AutomationProperties.Name="取消周期操作"
                    Content="返回"
                    IsCancel="True"
                    Style="{StaticResource Button.Secondary}" />
            <Button x:Name="ConfirmButton"
                    AutomationProperties.Name="确认周期操作"
                    IsDefault="True"
                    Click="OnConfirmClick"
                    Style="{StaticResource Button.Danger}" />
        </StackPanel>
    </Grid>
</Window>
