<UserControl x:Class="ScheduleAssistant.Presentation.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScheduleAssistant.Presentation.Controls">
    <ScrollViewer Padding="{DynamicResource Spacing.Page}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="{DynamicResource Spacing.Section}"
                       Style="{StaticResource Text.Body}"
                       Text="{Binding Description}" />
            <controls:PageStatePresenter State="{Binding ContentState}"
                                         StatusTitle="{Binding StatusTitle}"
                                         StatusMessage="{Binding StatusMessage}">
                <controls:PageStatePresenter.NormalContent>
                    <StackPanel>
                        <Border Margin="{DynamicResource Spacing.Section}"
                                Background="{DynamicResource Brush.AccentSoft}"
                                BorderBrush="{DynamicResource Brush.Accent}"
                                BorderThickness="{DynamicResource BorderThickness.Subtle}"
                                CornerRadius="{DynamicResource Radius.Card}"
                                Padding="{DynamicResource Spacing.Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Overline}" Text="最近截止 · 设计预览" />
                                    <TextBlock Margin="{DynamicResource Spacing.GapXSmall}"
                                               Style="{StaticResource Text.SectionTitle}"
                                               Text="整理文献综述提纲" />
                                    <TextBlock Margin="{DynamicResource Spacing.GapXSmall}"
                                               Style="{StaticResource Text.Body}"
                                               Text="明天 23:59 · 剩余约 1 天" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource Brush.Warning}"
                                        CornerRadius="{DynamicResource Radius.Pill}"
                                        Padding="{DynamicResource Spacing.Chip}"
                                        VerticalAlignment="Center">
                                    <TextBlock Foreground="{DynamicResource Brush.TextOnAccent}"
                                               FontWeight="{DynamicResource FontWeight.SemiBold}"
                                               Text="重要" />
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Margin="{DynamicResource Spacing.Section}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Text="今日计划" />
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TaskCard Margin="0,0,0,12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:PageStatePresenter.NormalContent>
            </controls:PageStatePresenter>
        </StackPanel>
    </ScrollViewer>
</UserControl>
