<UserControl x:Class="ScheduleAssistant.Presentation.Views.TodayView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScheduleAssistant.Presentation.Controls"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <ScrollViewer Padding="{DynamicResource Spacing.Page}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="{DynamicResource Spacing.Section}"
                       Style="{StaticResource Text.Body}"
                       Text="{Binding Description}" />
            <controls:PageStatePresenter State="{Binding ContentState}"
                                         StatusTitle="{Binding StatusTitle}"
                                         StatusMessage="{Binding StatusMessage}">
                <controls:PageStatePresenter.NormalContent>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,12"
                                   Style="{StaticResource Text.Caption}"
                                   Text="暂无未完成 Deadline"
                                   Visibility="{Binding HasNoDeadlineCountdown, Converter={StaticResource BooleanToVisibility}}" />
                        <Border Margin="{DynamicResource Spacing.Section}"
                                Background="{DynamicResource Brush.AccentSoft}"
                                BorderBrush="{DynamicResource Brush.Accent}"
                                BorderThickness="{DynamicResource BorderThickness.Subtle}"
                                CornerRadius="{DynamicResource Radius.Card}"
                                Padding="{DynamicResource Spacing.Card}"
                                Visibility="{Binding HasCountdown, Converter={StaticResource BooleanToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Overline}" Text="最近 Deadline" />
                                    <TextBlock Margin="{DynamicResource Spacing.GapXSmall}"
                                               Style="{StaticResource Text.SectionTitle}"
                                               Text="{Binding RecentDeadline.Title}" />
                                    <TextBlock Margin="{DynamicResource Spacing.GapXSmall}"
                                               Style="{StaticResource Text.Body}"
                                               Text="{Binding RecentDeadline.DeadlineText}" />
                                    <TextBlock Margin="{DynamicResource Spacing.GapXSmall}"
                                               Style="{StaticResource Text.Body}"
                                               Text="{Binding RecentDeadline.RemainingText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Border Background="{DynamicResource Brush.Warning}"
                                            CornerRadius="{DynamicResource Radius.Pill}"
                                            Padding="{DynamicResource Spacing.Chip}">
                                        <TextBlock Foreground="{DynamicResource Brush.TextOnAccent}"
                                                   FontWeight="{DynamicResource FontWeight.SemiBold}"
                                                   Text="{Binding RecentDeadline.UrgencyText}" />
                                    </Border>
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource Text.Caption}"
                                               Text="{Binding RecentDeadline.PriorityText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding AdditionalDeadlines}"
                                      Margin="0,0,0,18"
                                      Visibility="{Binding HasCountdown, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Style="{StaticResource CardBorder}">
                                        <Grid Margin="{DynamicResource Spacing.Card}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Text.CardTitle}" Text="{Binding Title}" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding DeadlineText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Margin="16,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Body}"
                                                       Text="{Binding RemainingText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="{DynamicResource Spacing.Section}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Text="已逾期"
                                   Visibility="{Binding HasOverdueTasks, Converter={StaticResource BooleanToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding OverdueTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><controls:TaskCard Margin="0,0,0,12" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="{DynamicResource Spacing.Section}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Text="计划已过但未完成"
                                   Visibility="{Binding HasPlannedPastTasks, Converter={StaticResource BooleanToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding PlannedPastTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><controls:TaskCard Margin="0,0,0,12" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="{DynamicResource Spacing.Section}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Text="今日计划"
                                   Visibility="{Binding HasPlannedTodayTasks, Converter={StaticResource BooleanToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding PlannedTodayTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><controls:TaskCard Margin="0,0,0,12" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="{DynamicResource Spacing.Section}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Text="今日 Deadline"
                                   Visibility="{Binding HasDeadlineTodayTasks, Converter={StaticResource BooleanToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding DeadlineTodayTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><controls:TaskCard Margin="0,0,0,12" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Header="已完成"
                                  IsExpanded="{Binding IsCompletedExpanded, Mode=TwoWay}"
                                  Visibility="{Binding HasCompletedTasks, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding CompletedTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><controls:TaskCard Margin="0,0,0,12" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </controls:PageStatePresenter.NormalContent>
            </controls:PageStatePresenter>
        </StackPanel>
    </ScrollViewer>
</UserControl>
