<Window x:Class="ScheduleAssistant.Presentation.Views.AmbiguousDeadlineChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择 Deadline 时刻"
        Width="560"
        Height="380"
        MinWidth="480"
        MinHeight="320"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource FontFamily.App}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="{DynamicResource Spacing.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="该时间在夏令时切换中出现两次" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource Text.Caption}"
                       Text="请选择一个有效时刻。系统不会自动替你选择。" />
            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding LocalDescription}" />
        </StackPanel>
        <ListBox Grid.Row="1"
                 Margin="0,16,0,16"
                 AutomationProperties.Name="DST 有效时刻"
                 ItemsSource="{Binding Choices}"
                 SelectedItem="{Binding SelectedChoice, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6">
                        <TextBlock FontWeight="{DynamicResource FontWeight.SemiBold}" Text="{Binding LocalText}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding UtcText}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    AutomationProperties.Name="取消选择 Deadline 时刻"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource Button.Secondary}" />
            <Button AutomationProperties.Name="确认 Deadline 时刻"
                    Click="OnConfirm"
                    Content="确认选择"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}" />
        </StackPanel>
    </Grid>
</Window>
