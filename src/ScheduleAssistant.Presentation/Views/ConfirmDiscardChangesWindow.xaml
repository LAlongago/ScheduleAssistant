<Window x:Class="ScheduleAssistant.Presentation.Views.ConfirmDiscardChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="放弃修改"
        Width="460"
        Height="250"
        MinWidth="420"
        MinHeight="220"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource FontFamily.App}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{DynamicResource Spacing.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40"
                    Height="40"
                    Background="{DynamicResource Brush.AccentSoft}"
                    CornerRadius="{DynamicResource Radius.Control}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="{DynamicResource FontWeight.Bold}"
                           Foreground="{DynamicResource Brush.Accent}"
                           Text="?" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="放弃修改？" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource Text.Body}"
                           Text="当前编辑器有未保存的修改。" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1"
                   Margin="52,12,0,16"
                   Style="{StaticResource Text.Caption}"
                   Text="放弃后，这些修改将不会保存。" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    AutomationProperties.Name="继续编辑"
                    Content="继续编辑"
                    IsCancel="True"
                    Style="{StaticResource Button.Secondary}" />
            <Button AutomationProperties.Name="放弃修改"
                    Content="放弃修改"
                    IsDefault="True"
                    Click="OnDiscardClick"
                    Style="{StaticResource Button.Danger}" />
        </StackPanel>
    </Grid>
</Window>
