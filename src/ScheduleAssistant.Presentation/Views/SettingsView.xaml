<UserControl x:Class="ScheduleAssistant.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScheduleAssistant.Presentation.Controls">
    <ScrollViewer Padding="{DynamicResource Spacing.Page}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="{DynamicResource Spacing.Section}"
                       Style="{StaticResource Text.Body}"
                       Text="{Binding Description}" />
            <controls:PageStatePresenter State="{Binding ContentState}"
                                         StatusTitle="{Binding StatusTitle}"
                                         StatusMessage="{Binding StatusMessage}">
                <controls:PageStatePresenter.NormalContent>
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}"
                                Padding="{DynamicResource Spacing.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="外观" />
                                <TextBlock Margin="{DynamicResource Spacing.GapXSmall}"
                                           Style="{StaticResource Text.Caption}"
                                           Text="主题资源已预留 Light / Dark 两组 token。" />
                                <CheckBox Margin="0,16,0,0"
                                          Content="启用深色主题（后续接入）"
                                          IsEnabled="False"
                                          ToolTip="主题切换将在设置任务中接入"
                                          AutomationProperties.Name="启用深色主题，尚未启用" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,16,0,0"
                                Style="{StaticResource CardBorder}"
                                Padding="{DynamicResource Spacing.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="应用生命周期" />
                                <TextBlock Margin="{DynamicResource Spacing.GapXSmall}"
                                           Style="{StaticResource Text.Caption}"
                                           Text="托盘、关闭行为和自启动留给 DEV-082 / DEV-083。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:PageStatePresenter.NormalContent>
            </controls:PageStatePresenter>
        </StackPanel>
    </ScrollViewer>
</UserControl>
