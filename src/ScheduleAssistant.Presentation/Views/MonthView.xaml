<UserControl x:Class="ScheduleAssistant.Presentation.Views.MonthView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScheduleAssistant.Presentation.Controls"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <ScrollViewer Padding="{DynamicResource Spacing.Page}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="{DynamicResource Spacing.Section}"
                       Style="{StaticResource Text.Body}"
                       Text="{Binding Description}" />

            <StackPanel Margin="0,0,0,18" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Text.SectionTitle}"
                           Text="{Binding DisplayedMonthText}" />
                <StackPanel Margin="{DynamicResource Spacing.GapLarge}"
                            Orientation="Horizontal">
                    <Button AutomationProperties.Name="上一个月"
                            Command="{Binding PreviousMonthCommand}"
                            Content="‹"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="上一个月" />
                    <Button Margin="{DynamicResource Spacing.GapXSmall}"
                            AutomationProperties.Name="回到本月"
                            Command="{Binding CurrentMonthCommand}"
                            Content="本月"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="回到本月" />
                    <Button AutomationProperties.Name="下一个月"
                            Command="{Binding NextMonthCommand}"
                            Content="›"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="下一个月" />
                </StackPanel>
            </StackPanel>

            <controls:PageStatePresenter State="{Binding ContentState}"
                                         StatusTitle="{Binding StatusTitle}"
                                         StatusMessage="{Binding StatusMessage}">
                <controls:PageStatePresenter.NormalContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,4">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Overline}" Text="周一" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Overline}" Text="周二" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Overline}" Text="周三" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Overline}" Text="周四" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Overline}" Text="周五" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Overline}" Text="周六" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Overline}" Text="周日" />
                        </UniformGrid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="{DynamicResource Spacing.GapXSmall}"
                                            Padding="{DynamicResource Spacing.GapSmall}">
                                        <Border.Style>
                                            <Style BasedOn="{StaticResource CardBorder}"
                                                   TargetType="{x:Type Border}">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInDisplayedMonth}" Value="False">
                                                        <Setter Property="Opacity" Value="0.56" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0"
                                                    HorizontalContentAlignment="Left"
                                                    AutomationProperties.Name="{Binding AccessibleDateText}"
                                                    Command="{Binding DataContext.OpenDateDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding Date}"
                                                    Content="{Binding DayNumberText}"
                                                    Style="{StaticResource Button.Quiet}"
                                                    ToolTip="打开日期详情" />
                                            <ItemsControl Grid.Row="1"
                                                          ItemsSource="{Binding VisibleEntries}"
                                                          Margin="0,4,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:TaskCard Margin="0,0,0,4" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Grid.Row="2"
                                                    HorizontalContentAlignment="Left"
                                                    AutomationProperties.Name="打开日期详情"
                                                    Command="{Binding DataContext.OpenDateDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding Date}"
                                                    Content="{Binding AdditionalEntryCount}"
                                                    ContentStringFormat="+{0}"
                                                    Foreground="{DynamicResource Brush.Accent}"
                                                    Style="{StaticResource Button.Quiet}"
                                                    ToolTip="打开当天完整事项"
                                                    Visibility="{Binding HasAdditionalEntries, Converter={StaticResource BooleanToVisibility}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </controls:PageStatePresenter.NormalContent>
            </controls:PageStatePresenter>

            <Border Margin="{DynamicResource Spacing.GapLarge}"
                    Padding="{DynamicResource Spacing.Window}"
                    Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsDateDetailsOpen, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="{DynamicResource Spacing.Section}">
                        <Button DockPanel.Dock="Right"
                                AutomationProperties.Name="关闭日期详情"
                                Command="{Binding CloseDateDetailsCommand}"
                                Content="关闭"
                                Style="{StaticResource Button.Quiet}"
                                ToolTip="关闭日期详情" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding SelectedDateText}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Text.Caption}"
                                       Text="日期详情" />
                        </StackPanel>
                    </DockPanel>
                    <controls:PageStatePresenter State="{Binding DateDetailsState}"
                                                 StatusTitle="{Binding DateDetailsStatusTitle}"
                                                 StatusMessage="{Binding DateDetailsStatusMessage}">
                        <controls:PageStatePresenter.NormalContent>
                            <ItemsControl ItemsSource="{Binding DateDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                      IsEnabled="{Binding IsCompletionEnabled}"
                                                      Command="{Binding CompletionCommand}"
                                                      CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                                      Style="{StaticResource CompletionCheckBox}" />
                                            <controls:TaskCard Grid.Column="1" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:PageStatePresenter.NormalContent>
                    </controls:PageStatePresenter>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
