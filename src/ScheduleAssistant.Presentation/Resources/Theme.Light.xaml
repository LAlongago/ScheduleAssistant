<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Core light theme tokens. Views consume brushes, typography, spacing,
        corner-radius, and border tokens through DynamicResource so a future theme
        switch can replace this dictionary without changing page XAML.
    -->
    <Color x:Key="Color.WindowBackground">#F7F8FA</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceSubtle">#F1F4F7</Color>
    <Color x:Key="Color.SurfaceSelected">#E8F0F2</Color>
    <Color x:Key="Color.Border">#D8E0E5</Color>
    <Color x:Key="Color.TextPrimary">#15232D</Color>
    <Color x:Key="Color.TextSecondary">#586772</Color>
    <Color x:Key="Color.TextMuted">#788690</Color>
    <Color x:Key="Color.TextOnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Accent">#2D6A73</Color>
    <Color x:Key="Color.AccentHover">#245863</Color>
    <Color x:Key="Color.AccentSoft">#DCECEF</Color>
    <Color x:Key="Color.Focus">#1F7783</Color>
    <Color x:Key="Color.Success">#247A55</Color>
    <Color x:Key="Color.Warning">#A96A00</Color>
    <Color x:Key="Color.Danger">#B64A45</Color>
    <Color x:Key="Color.Info">#3E6B99</Color>
    <Color x:Key="Color.CategoryResearch">#4F7CAC</Color>
    <Color x:Key="Color.CategoryCourse">#7A6FB1</Color>
    <Color x:Key="Color.CategoryMeeting">#C17C3D</Color>
    <Color x:Key="Color.CategoryAdmin">#6D7B84</Color>
    <Color x:Key="Color.CategoryLife">#4F8B73</Color>
    <Color x:Key="Color.CategoryOther">#8A6F9E</Color>

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.WindowBackground}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="{StaticResource Color.SurfaceSubtle}" />
    <SolidColorBrush x:Key="Brush.SurfaceSelected" Color="{StaticResource Color.SurfaceSelected}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.CategoryResearch" Color="{StaticResource Color.CategoryResearch}" />
    <SolidColorBrush x:Key="Brush.CategoryCourse" Color="{StaticResource Color.CategoryCourse}" />
    <SolidColorBrush x:Key="Brush.CategoryMeeting" Color="{StaticResource Color.CategoryMeeting}" />
    <SolidColorBrush x:Key="Brush.CategoryAdmin" Color="{StaticResource Color.CategoryAdmin}" />
    <SolidColorBrush x:Key="Brush.CategoryLife" Color="{StaticResource Color.CategoryLife}" />
    <SolidColorBrush x:Key="Brush.CategoryOther" Color="{StaticResource Color.CategoryOther}" />

    <FontFamily x:Key="FontFamily.App">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamily.Monospace">Cascadia Mono</FontFamily>
    <FontWeight x:Key="FontWeight.Regular">Regular</FontWeight>
    <FontWeight x:Key="FontWeight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeight.Bold">Bold</FontWeight>
    <sys:Double x:Key="FontSize.Display">25</sys:Double>
    <sys:Double x:Key="FontSize.Heading">18</sys:Double>
    <sys:Double x:Key="FontSize.Subheading">15</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Navigation">13</sys:Double>
    <sys:Double x:Key="FontSize.CardTitle">14</sys:Double>

    <Thickness x:Key="Spacing.Window">24</Thickness>
    <Thickness x:Key="Spacing.Sidebar">18,20,14,18</Thickness>
    <Thickness x:Key="Spacing.Header">24,20,28,18</Thickness>
    <Thickness x:Key="Spacing.Page">28,20,28,32</Thickness>
    <Thickness x:Key="Spacing.Card">16</Thickness>
    <Thickness x:Key="Spacing.Section">0,0,0,18</Thickness>
    <Thickness x:Key="Spacing.GapLarge">20</Thickness>
    <Thickness x:Key="Spacing.GapMedium">12</Thickness>
    <Thickness x:Key="Spacing.GapSmall">8</Thickness>
    <Thickness x:Key="Spacing.GapXSmall">4</Thickness>
    <Thickness x:Key="Spacing.IconLabel">8,0,0,0</Thickness>
    <Thickness x:Key="Spacing.HeaderTitle">12,0,20,0</Thickness>
    <Thickness x:Key="Spacing.Chip">8,4</Thickness>
    <Thickness x:Key="Spacing.Button">14,8</Thickness>
    <Thickness x:Key="Spacing.IconButton">8</Thickness>

    <CornerRadius x:Key="Radius.Window">16</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Control">9</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <CornerRadius x:Key="Radius.AccentBar">3</CornerRadius>
    <Thickness x:Key="BorderThickness.Subtle">1</Thickness>
    <Thickness x:Key="BorderThickness.Focus">2</Thickness>
</ResourceDictionary>
