<Window x:Class="ScheduleAssistant.Presentation.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScheduleAssistant.Presentation.ViewModels"
        xmlns:views="clr-namespace:ScheduleAssistant.Presentation.Views"
        Title="ScheduleAssistant"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource FontFamily.App}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TodayPageViewModel}">
            <views:TodayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WeekPageViewModel}">
            <views:WeekView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonthPageViewModel}">
            <views:MonthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpcomingDeadlinesPageViewModel}">
            <views:UpcomingDeadlinesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AllTasksPageViewModel}">
            <views:AllTasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar"
                Grid.RowSpan="3"
                Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Width" Value="248" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsNavigationExpanded, ElementName=RootWindow}" Value="False">
                            <Setter Property="Width" Value="80" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="{DynamicResource Spacing.Sidebar}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource Brush.Accent}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Height="38"
                            Width="38">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Foreground="{DynamicResource Brush.TextOnAccent}"
                                   Text="S"
                                   AutomationProperties.Name="ScheduleAssistant" />
                    </Border>
                    <StackPanel Margin="{DynamicResource Spacing.GapSmall}"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="{DynamicResource FontSize.Subheading}"
                                   FontWeight="{DynamicResource FontWeight.SemiBold}"
                                   Text="ScheduleAssistant" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="本地计划与 Deadline" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Margin="0,30,0,10"
                           Style="{StaticResource Text.Overline}"
                           Text="工作区"
                           Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl Grid.Row="2" ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Margin="0,0,0,6"
                                          AutomationProperties.Name="{Binding AccessibleName}"
                                          Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding Page}"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Style="{StaticResource NavigationItemButton}"
                                          ToolTip="{Binding Tooltip}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Width="28"
                                               FontSize="18"
                                               Text="{Binding IconGlyph}"
                                               TextAlignment="Center"
                                               ToolTip="{Binding Tooltip}"
                                               AutomationProperties.Name="{Binding AccessibleName}" />
                                    <TextBlock Margin="{DynamicResource Spacing.IconLabel}"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSize.Navigation}"
                                               Text="{Binding Label}"
                                               Visibility="{Binding DataContext.IsNavigationExpanded, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DockPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Row="3"
                        AutomationProperties.Name="折叠或展开导航"
                        Command="{Binding ToggleNavigationCommand}"
                        Style="{StaticResource Button.Quiet}"
                        ToolTip="折叠或展开导航">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="18" Text="‹" />
                        <TextBlock Margin="{DynamicResource Spacing.IconLabel}"
                                   VerticalAlignment="Center"
                                   Text="折叠导航"
                                   Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                Background="{DynamicResource Brush.WindowBackground}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="{DynamicResource Spacing.Header}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        AutomationProperties.Name="折叠或展开导航"
                        Command="{Binding ToggleNavigationCommand}"
                        Content="☰"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="折叠或展开导航" />
                <StackPanel Grid.Column="1" Margin="{DynamicResource Spacing.HeaderTitle}">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="{Binding CurrentTitle}" />
                    <TextBlock Margin="{DynamicResource Spacing.GapXSmall}"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding CurrentSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Margin="0,0,16,0"
                            Orientation="Horizontal">
                    <Button AutomationProperties.Name="上一个日期"
                            Command="{Binding PreviousDateCommand}"
                            Content="‹"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="{Binding DateNavigationHint}" />
                    <Button AutomationProperties.Name="当前日期"
                            Command="{Binding CurrentDateCommand}"
                            Content="{Binding DisplayDateText}"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="{Binding DateNavigationHint}" />
                    <Button AutomationProperties.Name="下一个日期"
                            Command="{Binding NextDateCommand}"
                            Content="›"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="{Binding DateNavigationHint}" />
                </StackPanel>
                <TextBox Grid.Column="3"
                         AutomationProperties.Name="搜索任务"
                         IsEnabled="{Binding IsSearchEnabled}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding SearchHint}" />
                <Button Grid.Column="4"
                        Margin="{DynamicResource Spacing.IconLabel}"
                        AutomationProperties.Name="新建任务"
                        Command="{Binding CreateTaskCommand}"
                        Content="新建任务"
                        IsEnabled="{Binding IsCreateTaskEnabled}"
                        Style="{StaticResource Button.Primary}"
                        ToolTip="{Binding CreateTaskHint}" />
            </Grid>
        </Border>

        <ContentControl Grid.Row="1"
                        Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        KeyboardNavigation.TabNavigation="Continue" />

        <Border Grid.Row="2"
                Grid.Column="1"
                Background="{DynamicResource Brush.SurfaceSubtle}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="{DynamicResource Spacing.GapSmall}">
            <TextBlock HorizontalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding ShellNotice}" />
        </Border>
    </Grid>
</Window>
